		end
		self.Value = state
		window:Tween(track, TI.Fast, { BackgroundColor3 = state and theme.Accent or theme.SurfaceLight })
		window:Tween(knob, TI.Fast, { Position = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0) })
		if flag then
